extends baseEmail

block content
  .email-content
    p.greeting Xin chào #{firstName},

    .description-box
      p #{subject}

    p Bạn vừa yêu cầu đặt lại mật khẩu SoulDiary. Dưới đây là mật khẩu mới của bạn:

    .reset-section
      .reset-label Mật khẩu mới
      .reset-container
        //- Hiển thị dạng "code box"
        pre(style="background:#f4f4f4; padding:12px 16px; border-radius:6px; font-size:16px; line-height:1.4; letter-spacing:0.5px; word-break:break-all;")
          code(style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;")
            | #{emailContent}

    .warning-section
      p
        strong Lưu ý:
        |  Vì lý do bảo mật, hãy đăng nhập và đổi mật khẩu ngay sau khi vào tài khoản. Vui lòng không chia sẻ mật khẩu này với bất kỳ ai.

    p Nếu bạn không thực hiện yêu cầu này, vui lòng bỏ qua email này hoặc liên hệ với bộ phận hỗ trợ khách hàng của chúng tôi.

  .email-footer
    .signature
      | Trân trọng,
      br
      strong Đội ngũ SoulDiary